# Telegram API credentials (obtain from https://my.telegram.org)
TG_API_ID=123456
TG_API_HASH="your_api_hash_here"

# Telegram Bot Token (obtain from @BotFather)
TG_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# ═══════════════════════════════════════════════════════════════════════
# Security — Fernet key for encrypting user sessions
# ═══════════════════════════════════════════════════════════════════════

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPT_KEY="your_fernet_key_here"

# ═══════════════════════════════════════════════════════════════════════
# TeraBox Credentials — extracted from browser session
# ═══════════════════════════════════════════════════════════════════════

# Full cookie string (from Request Headers → Cookie) containing 'ndus'
TERABOX_COOKIE="browserid=...; ndus=YOUR_NDUS_VALUE; ..."

# Optional: jsToken and bdstoken (will be auto-resolved from cookie if not provided)
TERABOX_JSTOKEN=""
TERABOX_BDSTOKEN=""

# Optional: Additional TeraBox tokens (auto-resolved during normal operation)
# Only set these if auto-resolution fails or you need to override
TERABOX_SIGN=""
TERABOX_TIMESTAMP=""
TERABOX_LOGID=""

# ═══════════════════════════════════════════════════════════════════════
# Download Management & Admin Settings
# ═══════════════════════════════════════════════════════════════════════

# Max concurrent downloads processed bot-wide (default is 20)
MAX_CONCURRENT_DOWNLOADS=20

# Max cumulative concurrent downloads allowed for all Free users combined (QoS safeguard, default is 10)
MAX_CONCURRENT_FREE_TOTAL=10

# Per-user max download size in MB (default: 100 MB for free, 1000 MB for premium)
MAX_SIZE_FREE_MB=100
MAX_SIZE_PREMIUM_MB=1000

# Per-user max concurrent downloads (default: 1 for free, 5 for premium)
MAX_CONCURRENT_FREE=1
MAX_CONCURRENT_PREMIUM=5

# Comma-separated list of Admin Telegram User IDs (e.g. 123456789,987654321)
ADMIN_IDS="123456789"

# Optional: gallery-dl browser cookie sharing (e.g. chrome, edge, firefox, opera, safari)
# Required to download from restricted sites (Twitter/X, Instagram) on your host system.
# Leave blank when running inside Docker.
GDL_COOKIES_FROM_BROWSER=""

# Optional: Reddit API credentials (fallback — used if site-specific vars are not set)
REDDIT_FALLBACK_CLIENT_ID=""
REDDIT_FALLBACK_CLIENT_SECRET=""
REDDIT_FALLBACK_REFRESH_TOKEN=""

# Optional: Specific client configuration for gallery-dl Reddit extractor
# (Falls back to REDDIT_FALLBACK_CLIENT_ID, etc. if not set)
GDL_REDDIT_CLIENT_ID=""
GDL_REDDIT_CLIENT_SECRET=""
GDL_REDDIT_REFRESH_TOKEN=""

# Optional: Specific client configuration for RedditDownloader (PRAW)
# (Falls back to REDDIT_FALLBACK_CLIENT_ID, etc. if not set)
REDDIT_PRAW_CLIENT_ID=""
REDDIT_PRAW_CLIENT_SECRET=""
REDDIT_PRAW_REFRESH_TOKEN=""
