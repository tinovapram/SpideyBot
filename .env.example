# ═══════════════════════════════════════════════════════════════════════
# SpideyBot — environment template
#
#     cp .env.example .env      then fill in the values below.
#
# .env is gitignored — never commit real credentials.
#
# Only SECRETS belong here. Everything else (tier limits, concurrency,
# intervals, database host/port/name) lives in config/default.toml, and any
# of it can still be overridden by an environment variable when needed.
#
# Sessions and cookies are NOT set here — they are plaintext files under
# data/sessions/ and data/cookies/, created by /login and /setting.
#
# ── How to write values ───────────────────────────────────────────────
# Plain values need NO quotes:
#     SPIDEY_ADMIN_IDS=123456789,987654321
# Quote only when a value contains '#', leading/trailing spaces, or a
# newline. Use SINGLE quotes, which are taken literally:
#     SPIDEY_EXAMPLE='value with # inside'
# Double quotes are NOT literal — they expand ${VAR} and backslash escapes:
#     SPIDEY_EXAMPLE="prefix-${SPIDEY_TG_API_ID}"
# '#' starts a comment; inside a value it is only stripped when preceded by
# a space, so quote a value that legitimately contains '#'.
# ═══════════════════════════════════════════════════════════════════════

# ── Telegram API credentials ──────────────────────────────────────────
# From https://my.telegram.org -> "API development tools".
#   SPIDEY_TG_API_ID=12345678
#   SPIDEY_TG_API_HASH=0123456789abcdef0123456789abcdef
SPIDEY_TG_API_ID=
SPIDEY_TG_API_HASH=

# ── Telegram bot token ────────────────────────────────────────────────
# From @BotFather. Form is <digits>:<secret>.
#   SPIDEY_TG_BOT_TOKEN=123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
SPIDEY_TG_BOT_TOKEN=

# ── PostgreSQL ────────────────────────────────────────────────────────
# Host, port, database and user live in config/default.toml under [db].
# Only the password is a secret.
#   SPIDEY_DB_PASSWORD=change-me
SPIDEY_DB_PASSWORD=

# ── Admins ────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs. No spaces, no quotes.
#   SPIDEY_ADMIN_IDS=123456789,987654321
SPIDEY_ADMIN_IDS=

# ── TeraBox ───────────────────────────────────────────────────────────
# Optional operator-supplied fallback pool, used only for users who have
# not set their own cookie through /setting.
#
# A cookie is itself a ';'-separated list of key=value pairs, so ';' can
# NOT separate accounts — it would split a single cookie into pieces. The
# account separator is '|'. Both ';' and '|' sit outside quotes; nothing in
# these values needs quoting.
#
#   single account:
#   SPIDEY_TERABOX_COOKIES=ndus=abc123def456; lang=en; other=1
#
#   two accounts, rotated round-robin, blocked ones skipped:
#   SPIDEY_TERABOX_COOKIES=ndus=abc123def456; lang=en|ndus=xyz789ghi012; lang=en
#
# If a cookie could itself contain '|', use one cookie per line in a file
# instead of this variable.
SPIDEY_TERABOX_COOKIES=

# From the TeraBox URL query string; usually left blank.
#   SPIDEY_TERABOX_JSTOKEN=abc123
SPIDEY_TERABOX_JSTOKEN=

# From the TeraBox URL query string; usually left blank.
#   SPIDEY_TERABOX_BDSTOKEN=xyz789
SPIDEY_TERABOX_BDSTOKEN=

# ── gallery-dl (optional) ─────────────────────────────────────────────
# Borrow cookies from a local browser profile: chrome, edge, firefox,
# opera or safari. Leave blank inside Docker — there is no profile there.
# Restricted sites (Twitter/X, Instagram) need this on a bare-metal host.
#   SPIDEY_GDL_COOKIES_FROM_BROWSER=chrome
SPIDEY_GDL_COOKIES_FROM_BROWSER=

# ── Reddit (optional) ─────────────────────────────────────────────────
# Used by the gallery-dl fallback.
#   SPIDEY_GDL_REDDIT_CLIENT_ID=abc123XYZ
#   SPIDEY_GDL_REDDIT_REFRESH_TOKEN=abc123-def456
SPIDEY_GDL_REDDIT_CLIENT_ID=
SPIDEY_GDL_REDDIT_REFRESH_TOKEN=

# Used by the PRAW fallback.
#   SPIDEY_REDDIT_PRAW_CLIENT_ID=abc123XYZ
#   SPIDEY_REDDIT_PRAW_CLIENT_SECRET=0123456789abcdef
SPIDEY_REDDIT_PRAW_CLIENT_ID=
SPIDEY_REDDIT_PRAW_CLIENT_SECRET=

# ── Runtime overrides (optional) ──────────────────────────────────────
# Every setting in config/default.toml can be overridden by an environment
# variable named after its path, upper-cased, with '__' between levels:
#   [tier.free] daily_downloads -> SPIDEY_TIER__FREE__DAILY_DOWNLOADS
#   [runtime]   max_concurrent  -> SPIDEY_RUNTIME__MAX_CONCURRENT
#   SPIDEY_RUNTIME__MAX_CONCURRENT=20
# A typo'd key fails startup rather than being silently ignored.

# ── Testing (optional) ────────────────────────────────────────────────
# Point the integration suite at an existing Postgres instead of starting a
# local one. Left blank, tests use the bundled binaries, then Docker.
#   SPIDEY_TEST_DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/spideybot_test
SPIDEY_TEST_DATABASE_URL=

# ── Live tests (optional) ─────────────────────────────────────────────
# Enables `pytest -m live`, which runs against Telegram's TEST servers —
# never production. Use throwaway accounts only.
#
# Test accounts use reserved numbers of the form 99966XYYYY, where X is the
# data-centre number (1-3) and YYYY is random. The login code is computable:
# it is the data-centre digit repeated five or six times, so DC 2 gives
# 22222 or 222222. That is what makes the login flow automatable with no
# phone. Live sessions live under data/sessions/test/, so they can never
# clobber a real user's session.
#
#   SPIDEY_TEST_MODE=true
#   SPIDEY_TEST_PHONE=9996621234
#   SPIDEY_TEST_PHONE_B=9996625678
SPIDEY_TEST_MODE=
SPIDEY_TEST_PHONE=
SPIDEY_TEST_PHONE_B=
