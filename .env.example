# Telegram API credentials (obtain from https://my.telegram.org)
TG_API_ID=123456
TG_API_HASH="your_api_hash_here"

# Telegram Bot Token (obtain from @BotFather)
TG_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# ═══════════════════════════════════════════════════════════════════
# Security — Fernet key (only used to decrypt LEGACY session files)
# ═══════════════════════════════════════════════════════════════════
# Sessions are now stored as Telethon SQLite .session files in ./user_sessions.
# This key is only needed to migrate old encrypted StringSession .json files.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPT_KEY="your_fernet_key_here"

# ═══════════════════════════════════════════════════════════════════
# TeraBox Credentials — extracted from browser session
# ═══════════════════════════════════════════════════════════════════

# Optional multi-account (multi-ndus): one full cookie per account, separated by '|'.
# Only the ndus part matters per entry. When TERABOX_COOKIES is set it overrides
# TERABOX_COOKIE. Accounts rotate round-robin; blocked/limited ones are skipped.
# Example:
# TERABOX_COOKIES="ndus=COOKIE_ACCOUNT_A|ndus=COOKIE_ACCOUNT_B|ndus=COOKIE_ACCOUNT_C"
TERABOX_COOKIE="browserid=...; ndus=YOUR_NDUS_VALUE; ..."
TERABOX_JSTOKEN=""
TERABOX_BDSTOKEN=""

# ═══════════════════════════════════════════════════════════════════
# Download management & admin settings
# ═══════════════════════════════════════════════════════════════════
MAX_CONCURRENT_DOWNLOADS=20
MAX_CONCURRENT_FREE_TOTAL=10
MAX_SIZE_FREE_MB=100
MAX_SIZE_PREMIUM_MB=1000
MAX_CONCURRENT_FREE=1
MAX_CONCURRENT_PREMIUM=5
ADMIN_IDS="123456789"

# Optional: gallery-dl browser cookie sharing (chrome, edge, firefox, ...)
GDL_COOKIES_FROM_BROWSER=""

# Optional: Reddit API credentials
REDDIT_FALLBACK_CLIENT_ID=""
REDDIT_FALLBACK_CLIENT_SECRET=""
REDDIT_FALLBACK_REFRESH_TOKEN=""
GDL_REDDIT_CLIENT_ID=""
GDL_REDDIT_CLIENT_SECRET=""
GDL_REDDIT_REFRESH_TOKEN=""
REDDIT_PRAW_CLIENT_ID=""
REDDIT_PRAW_CLIENT_SECRET=""
REDDIT_PRAW_REFRESH_TOKEN=""
