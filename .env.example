# -------------------------------------------------------------------
# Telegram API credentials (obtain from https://my.telegram.org)
# -------------------------------------------------------------------
SPIDEY_TG_API_ID=123456
SPIDEY_TG_API_HASH="your_api_hash_here"

# Telegram Bot Token (obtain from @BotFather)
SPIDEY_TG_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# -------------------------------------------------------------------
# Database (PostgreSQL) � async SQLAlchemy + asyncpg
# Docker Compose overrides this with the internal `postgres` hostname.
# -------------------------------------------------------------------
SPIDEY_DATABASE_URL="postgresql+asyncpg://spidey:spidey@localhost:5432/spideybot"

# -------------------------------------------------------------------
# Security � Fernet key. Encrypts per-user TeraBox cookies and decrypts
# LEGACY session files. It does NOT encrypt the Telethon *.session files
# written today: those are plaintext SQLite under user_sessions/, so the
# volume holding them must be protected by permissions/disk encryption.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -------------------------------------------------------------------
SPIDEY_SESSION_ENCRYPT_KEY="your_fernet_key_here"

# -------------------------------------------------------------------
# TeraBox credentials � one cookie per account, "|"-delimited
# These are BOT-OWNED accounts: admins may use them, and they back the shared
# pool. Every other user must save their own ndus cookie (/setting) before
# TeraBox downloads are allowed.
# -------------------------------------------------------------------
SPIDEY_TERABOX_COOKIES="ndus=YOUR_NDUS_VALUE"
SPIDEY_TERABOX_JSTOKEN=""
SPIDEY_TERABOX_BDSTOKEN=""
# Optional signed-request values; normally resolved automatically.
SPIDEY_TERABOX_SIGN=""
SPIDEY_TERABOX_TIMESTAMP=""
SPIDEY_TERABOX_LOGID=""

# -------------------------------------------------------------------
# TeraBox transfer backend
#   auto        � pick best method automatically (default)
#   aria2       � multi-connection via aria2c
#   segmented   � parallel HTTP chunks
#   single      � simple requests.get
# -------------------------------------------------------------------
SPIDEY_TERABOX_TRANSFER="auto"
SPIDEY_TERABOX_TRANSFER_MIN_MB=32
SPIDEY_TERABOX_SEGMENT_CONNECTIONS=8
SPIDEY_TERABOX_ARIA2_CONNECTIONS=16

# -------------------------------------------------------------------
# Admin � comma-separated Telegram user IDs
# -------------------------------------------------------------------
SPIDEY_ADMIN_IDS="123456789"

# -------------------------------------------------------------------
# Limits & behavior
# -------------------------------------------------------------------
SPIDEY_MAX_CONCURRENT_DOWNLOADS=20
# Lower to ~8 on a small VPS: each worker can run a video pipeline and they
# all share one event loop.
SPIDEY_RATE_LIMIT_PER_MINUTE=12
# Comma-separated proxies for downloaders that need IP rotation.
SPIDEY_PROXY_POOL=""
SPIDEY_SESSION_MAX_LIVE=50
# Idle timeout before a live client is disconnected. The session file is kept,
# so /start reconnects without a new login. Per tier: free, pro, premium.
SPIDEY_SESSION_IDLE_SECONDS=1800          # free (also the fallback)
SPIDEY_SESSION_IDLE_PRO_SECONDS=43200     # 12 h
SPIDEY_SESSION_IDLE_PREMIUM_SECONDS=86400 # 24 h
# Sessionless users may occupy at most this many of the download workers;
# the rest are reserved for users with a live session. 0 disables the split.
SPIDEY_SESSIONLESS_WORKER_SLOTS=5
SPIDEY_DEFAULT_TIMER_MEDIA=true
SPIDEY_DEFAULT_MAGIC_WORD=WOW

# -------------------------------------------------------------------
# Media preparation & send pacing (core/sendgate.py)
#   The limited unit is one prepared media (one file), whether it is
#   later sent in an album or on its own.
#   MEDIA_CONCURRENCY � media in flight on the shared bot client
#     (0 = follow SPIDEY_SESSIONLESS_WORKER_SLOTS). User sessions use
#     their own tier concurrency instead.
#   MEDIA_PER_MINUTE � media prepared per minute, per client
#   MEDIA_BURST � media that may start in the same instant
#   SEND_CHAT_PER_MINUTE / SEND_BURST � message RPCs per chat (an album
#     of 10 costs one), used for Telegram's per-chat message limit
# -------------------------------------------------------------------
SPIDEY_MEDIA_CONCURRENCY=5
SPIDEY_MEDIA_PER_MINUTE=60
SPIDEY_MEDIA_BURST=5
SPIDEY_SEND_CHAT_PER_MINUTE=20
SPIDEY_SEND_BURST=5
SPIDEY_FLOOD_JITTER_SECONDS=2.0
SPIDEY_SEND_MAX_ATTEMPTS=4

# -------------------------------------------------------------------
# Camoufox (anti-detection browser used by /bypass and some sites)
#   HEADLESS: "" (auto) | virtual | 1 | 0
# -------------------------------------------------------------------
SPIDEY_CAMOUFOX_MAX_CONCURRENCY=2
SPIDEY_CAMOUFOX_HEADLESS=""

# -------------------------------------------------------------------
# Tier configuration � all values are in MB, downloads, or slots
# Admin always gets premium limits regardless of these settings.
# -------------------------------------------------------------------

# CONCURRENT_MODE: "reject" (refuse when slots are full) or "queue"
#
# Free tier
SPIDEY_TIER_FREE_LINK_TOTAL_MB=500
SPIDEY_TIER_FREE_DAILY_DOWNLOADS=10
SPIDEY_TIER_FREE_DAILY_MB=1024
SPIDEY_TIER_FREE_CONCURRENT=1
SPIDEY_TIER_FREE_PRIORITY=2.0
SPIDEY_TIER_FREE_CONCURRENT_MODE=reject

# Pro tier
SPIDEY_TIER_PRO_LINK_TOTAL_MB=10240
SPIDEY_TIER_PRO_DAILY_DOWNLOADS=50
SPIDEY_TIER_PRO_DAILY_MB=25600
SPIDEY_TIER_PRO_CONCURRENT=2
SPIDEY_TIER_PRO_PRIORITY=1.0
SPIDEY_TIER_PRO_CONCURRENT_MODE=reject

# Premium tier
SPIDEY_TIER_PREMIUM_DAILY_DOWNLOADS=200
SPIDEY_TIER_PREMIUM_DAILY_MB=102400
SPIDEY_TIER_PREMIUM_CONCURRENT=3
SPIDEY_TIER_PREMIUM_PRIORITY=0.5
SPIDEY_TIER_PREMIUM_CONCURRENT_MODE=reject

# -------------------------------------------------------------------
# Queue / job settings
# -------------------------------------------------------------------
SPIDEY_JOB_MAX_ATTEMPTS=3

# -- Observability -----------------------------------------------
SPIDEY_METRICS_HOST=0.0.0.0
SPIDEY_METRICS_PORT=9090

# ═══════════════════════════════════════════════════════════════════
# Watchdogs (core/watchdog.py)
#   A blocked event loop or a dropped Telegram connection makes the bot
#   answer nothing while the process keeps running. These detect both:
#   the loop lag is logged, a dead bot client is reconnected, and the
#   process exits after MAX_RECONNECTS failures so Docker restarts it.
# ═══════════════════════════════════════════════════════════════════
SPIDEY_LOOP_LAG_THRESHOLD_SECONDS=2.0
SPIDEY_WATCHDOG_INTERVAL_SECONDS=30
SPIDEY_WATCHDOG_GRACE_SECONDS=60
SPIDEY_WATCHDOG_MAX_RECONNECTS=5

# -------------------------------------------------------------------
# Referral rewards
# -------------------------------------------------------------------
SPIDEY_REFERRAL_DAILY_BONUS=10
SPIDEY_REFERRAL_BONUS_DAYS=30

# -------------------------------------------------------------------
# Optional: Reddit API credentials
# -------------------------------------------------------------------
SPIDEY_REDDIT_FALLBACK_CLIENT_ID=""
SPIDEY_REDDIT_FALLBACK_CLIENT_SECRET=""
SPIDEY_REDDIT_FALLBACK_REFRESH_TOKEN=""
SPIDEY_GDL_REDDIT_CLIENT_ID=""
SPIDEY_GDL_REDDIT_CLIENT_SECRET=""
SPIDEY_GDL_REDDIT_REFRESH_TOKEN=""
SPIDEY_REDDIT_PRAW_CLIENT_ID=""
SPIDEY_REDDIT_PRAW_CLIENT_SECRET=""
SPIDEY_REDDIT_PRAW_REFRESH_TOKEN=""
SPIDEY_GDL_COOKIES_FROM_BROWSER=""
