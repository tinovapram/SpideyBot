# ═══════════════════════════════════════════════════════════════════
# Telegram API credentials (obtain from https://my.telegram.org)
# ═══════════════════════════════════════════════════════════════════
SPIDEY_TG_API_ID=123456
SPIDEY_TG_API_HASH="your_api_hash_here"

# Telegram Bot Token (obtain from @BotFather)
SPIDEY_TG_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# ═══════════════════════════════════════════════════════════════════
# Database (PostgreSQL) — async SQLAlchemy + asyncpg
# Docker Compose overrides this with the internal `postgres` hostname.
# ═══════════════════════════════════════════════════════════════════
SPIDEY_DATABASE_URL="postgresql+asyncpg://spidey:spidey@localhost:5432/spideybot"

# ═══════════════════════════════════════════════════════════════════
# Security — Fernet key (used to decrypt LEGACY session files and
# encrypt per-user Terabox cookies)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ═══════════════════════════════════════════════════════════════════
SPIDEY_SESSION_ENCRYPT_KEY="your_fernet_key_here"

# ═══════════════════════════════════════════════════════════════════
# TeraBox credentials — one cookie per account, "|"-delimited
# ═══════════════════════════════════════════════════════════════════
SPIDEY_TERABOX_COOKIES="ndus=YOUR_NDUS_VALUE"
SPIDEY_TERABOX_JSTOKEN=""
SPIDEY_TERABOX_BDSTOKEN=""

# ═══════════════════════════════════════════════════════════════════
# TeraBox transfer backend
#   auto        — pick best method automatically (default)
#   aria2       — multi-connection via aria2c
#   segmented   — parallel HTTP chunks
#   single      — simple requests.get
# ═══════════════════════════════════════════════════════════════════
SPIDEY_TERABOX_TRANSFER="auto"
SPIDEY_TERABOX_TRANSFER_MIN_MB=32
SPIDEY_TERABOX_SEGMENT_CONNECTIONS=8
SPIDEY_TERABOX_ARIA2_CONNECTIONS=16

# ═══════════════════════════════════════════════════════════════════
# Admin — comma-separated Telegram user IDs
# ═══════════════════════════════════════════════════════════════════
SPIDEY_ADMIN_IDS="123456789"

# ═══════════════════════════════════════════════════════════════════
# Limits & behavior
# ═══════════════════════════════════════════════════════════════════
SPIDEY_MAX_CONCURRENT_DOWNLOADS=20
SPIDEY_RATE_LIMIT_PER_MINUTE=12
SPIDEY_SESSION_MAX_LIVE=50
SPIDEY_SESSION_IDLE_SECONDS=600
SPIDEY_DOWNLOADS_RETENTION_DAYS=3

# ═══════════════════════════════════════════════════════════════════
# Queue / job settings
# ═══════════════════════════════════════════════════════════════════
SPIDEY_JOB_LEASE_SECONDS=300
SPIDEY_JOB_MAX_ATTEMPTS=3

# ═══════════════════════════════════════════════════════════════════
# Referral rewards
# ═══════════════════════════════════════════════════════════════════
SPIDEY_REFERRAL_DAILY_BONUS=10
SPIDEY_REFERRAL_BONUS_DAYS=30

# ═══════════════════════════════════════════════════════════════════
# Optional: Reddit API credentials
# ═══════════════════════════════════════════════════════════════════
SPIDEY_REDDIT_FALLBACK_CLIENT_ID=""
SPIDEY_REDDIT_FALLBACK_CLIENT_SECRET=""
SPIDEY_REDDIT_FALLBACK_REFRESH_TOKEN=""
SPIDEY_GDL_REDDIT_CLIENT_ID=""
SPIDEY_GDL_REDDIT_CLIENT_SECRET=""
SPIDEY_GDL_REDDIT_REFRESH_TOKEN=""
SPIDEY_REDDIT_PRAW_CLIENT_ID=""
SPIDEY_REDDIT_PRAW_CLIENT_SECRET=""
SPIDEY_REDDIT_PRAW_REFRESH_TOKEN=""
