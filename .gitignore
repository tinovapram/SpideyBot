# ── Secrets ────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Runtime data (includes plaintext session/cookie files) ─────────
# The tree itself is created by app/paths.ensure_runtime_dirs() on first run, so
# nothing under here is tracked. Note that a "!data/.gitkeep" exception could never
# work: git cannot re-include a file whose parent directory is excluded.
data/

# ── Telegram sessions — credentials, never commit ──────────────────
*.session
*.session-journal

# ── Config overrides ───────────────────────────────────────────────
config/local.toml
config/runtime/

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# ── Virtual environments ───────────────────────────────────────────
.venv/
venv/
env/

# ── Testing / linting / coverage / type checking ───────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ── IDE / editor ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Runtime output ─────────────────────────────────────────────────
downloads/
user_sessions/
graphify-out/
