# ═══════════════════════════════════════════════════════════════════════
# SpideyBot — .gitignore
# ═══════════════════════════════════════════════════════════════════════

# ─── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/

# ─── Virtual Environments ───────────────────────────────────────────
.env
.venv/
env/
venv/

# ─── IDE / Editor ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Testing / Coverage ─────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ─── Type Checking ──────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ─── Sensitive / Secrets ────────────────────────────────────────────
# Never commit API tokens, cookies, or encryption keys
# .env is already ignored above; this catches any .env.* variants
.env.*
!.env.example

# ─── Database ───────────────────────────────────────────────────────
data/*.db
data/*.db-journal
data/

# ─── User Sessions (Encrypted) ─────────────────────────────────────
# Each user has an encrypted .session file — never commit
user_sessions/
!user_sessions/.gitkeep

# ─── Runtime-Generated Configs ─────────────────────────────────────
# gallery-dl runtime config is regenerated on every bot start
config/runtime/
!config/runtime/.gitkeep

# ─── Downloads ──────────────────────────────────────────────────────
downloads/

# ─── Telethon ───────────────────────────────────────────────────────
*.session
*.session-journal

# ─── Backups ────────────────────────────────────────────────────────
MyBot_Backup_*/

# ─── OS Files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ───────────────────────────────────────────────────────────
*.log

# ─── Graph / Knowledge Graph ───────────────────────────────────────
graphify-out/

# ─── Session Notes / Plans (temporary) ─────────────────────────────
*_WRAPUP*.md
*_PLAN*.md
SESSION_*.md
Summary.md
WRAPUP_*.md

graphify-out/*